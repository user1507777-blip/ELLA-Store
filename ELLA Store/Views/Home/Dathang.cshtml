@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ELLA - Thông Tin Đặt Hàng</title>
    <link rel="stylesheet" href="~/Content/css/style.css">
    <style>
        /* CSS cho khung nhập thông tin đặt hàng */
        .checkout-container {
            max-width: 600px;
            margin: 50px auto;
            padding: 30px;
            background: #ffffff;
            border: 1px solid #e1e1e1;
            border-radius: 8px;
            font-family: 'Segoe UI', Arial, sans-serif;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        }
        /* Tiêu đề */
        .checkout-title {
            text-align: center;
            color: #111;
            text-transform: uppercase;
            margin-bottom: 25px;
            letter-spacing: 1px;
            font-size: 24px;
        }
        /* Khung hiển thị tổng tiền */
        .bill-summary {
            background-color: #f9f9f9;
            padding: 15px 20px;
            border-left: 4px solid #000000;
            margin-bottom: 25px;
            font-size: 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        /* Khoảng cách giữa các ô nhập */
        .form-group {
            margin-bottom: 18px;
        }

            .form-group label {
                display: block;
                margin-bottom: 6px;
                font-weight: 600;
                color: #333;
                font-size: 14px;
            }
            /* Ô nhập thông tin */
            .form-group input {
                width: 100%;
                padding: 12px;
                box-sizing: border-box;
                border: 1px solid #ccc;
                border-radius: 4px;
                font-size: 14px;
            }

                .form-group input:focus {
                    border-color: #000;
                    outline: none;
                }
        /* Nút xác nhận đặt hàng */
        .btn-order {
            background-color: #000000;
            color: #ffffff;
            border: none;
            padding: 14px;
            font-size: 16px;
            font-weight: bold;
            border-radius: 4px;
            cursor: pointer;
            width: 100%;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-top: 10px;
        }

            .btn-order:hover {
                background-color: #333333;
            }
    </style>
</head>
<body>
    <!-- Menu -->
    <nav class="main-menu container-custom">
        <ul>
            <li><a href="/Home/Index">Trang chủ</a></li>
            <li><a href="/Home/Dangnhap">Tài khoản</a></li>
        </ul>
    </nav>
    <!-- Form nhập thông tin khách hàng -->
    <div class="checkout-container">
        <h2 class="checkout-title">Thông Tin Nhận Hàng</h2>
        <!-- Hiển thị tổng tiền lấy từ giỏ hàng -->
        <div class="bill-summary">
            <span>Thành tiền cần thanh toán:</span>
            <strong style="color: #e74c3c; font-size: 20px;"><span id="tongTienBill">0</span>đ</strong>
        </div>
        <!-- Nhập họ tên -->
        <div class="form-group">
            <label>Họ và tên khách hàng *</label>
            <input type="text" id="txtHoTen" placeholder="Nhập đầy đủ họ và tên người nhận">
        </div>
        <!-- Nhập số điện thoại -->
        <div class="form-group">
            <label>Số điện thoại nhận hàng *</label>
            <input type="text" id="txtSoDienThoai" placeholder="Nhập số điện thoại liên hệ">
        </div>
        <!-- Nhập email -->
        <div class="form-group">
            <label>Địa chỉ Email</label>
            <input type="email" id="txtEmail" placeholder="Nhập địa chỉ email (không bắt buộc)">
        </div>
        <!-- Nhập địa chỉ -->
        <div class="form-group">
            <label>Địa chỉ giao hàng *</label>
            <input type="text" id="txtDiaChi" placeholder="Số nhà, tên đường, phường/xã, quận/huyện">
        </div>
        <!-- Nút xác nhận đặt hàng -->
        <button type="button" class="btn-order" onclick="xuLyGoiDonHangDat()">
            Xác Nhận Đặt Hàng & Thanh Toán
        </button>
    </div>
    <script>
        // Lấy tổng tiền từ giỏ hàng
        const tongTienHienTai = parseFloat(localStorage.getItem("cartTotal")) || 0;
        // Hiển thị tổng tiền
        document.getElementById("tongTienBill").innerText = tongTienHienTai.toLocaleString("vi-VN");
        // Hàm xử lý khi người dùng bấm xác nhận đặt hàng
        function xuLyGoiDonHangDat() {
            // Lấy thông tin người dùng nhập
            const hoten = document.getElementById("txtHoTen").value.trim();
            const sdt = document.getElementById("txtSoDienThoai").value.trim();
            const email = document.getElementById("txtEmail").value.trim();
            const diachi = document.getElementById("txtDiaChi").value.trim();
            // Kiểm tra thông tin bắt buộc
            if (!hoten || !sdt || !diachi) {
                alert("Vui lòng điền đầy đủ các thông tin bắt buộc có dấu (*)!");
                return;
            }
            // Lưu thông tin để bill.html lấy lại
            localStorage.setItem("hoTen", hoten);
            localStorage.setItem("soDienThoai", sdt);
            localStorage.setItem("email", email);
            localStorage.setItem("diaChi", diachi);
            // Chuyển sang trang bill
            window.location.href = "/Home/Bill";
        }
    </script>
    <!-- FOOTER -->
    <footer class="footer">
        <div class="footer-content">
            <div class="footer-section trai">
                <h3>VỀ ELLA STORE</h3>
                <p>Hệ thống thời trang giày dép uy tín, chất lượng hàng đầu.</p>
                <p>Địa chỉ: 123 Đường ABC, TP.HCM</p>
                <p>Hotline: 0123 456 789</p>
            </div>
            <div class="footer-section trai">
                <h3>HỖ TRỢ KHÁCH HÀNG</h3>
                <p><a href="#">Hướng dẫn mua hàng</a></p>
                <p><a href="#">Chính sách đổi trả</a></p>
                <p><a href="#">Chính sách bảo mật</a></p>
                <p><a href="#">Phương thức thanh toán</a></p>
            </div>
            <div class="footer-section phai">
                <h3>CHÍNH SÁCH</h3>
                <p><a href="#">Chính sách vận chuyển</a></p>
                <p><a href="#">Chính sách kiểm hàng</a></p>
                <p><a href="#">Quy định chung</a></p>
            </div>
            <div class="footer-section phai">
                <h3>KẾT NỐI VỚI CHÚNG TÔI</h3>
                <p><a href="#">Facebook</a> | <a href="#">Instagram</a></p>
                <p><a href="#">TikTok</a> | <a href="#">Shopee</a></p>
                <h3 style="margin-top: 15px; font-size: 15px;">ĐĂNG KÝ NHẬN TIN</h3>
                <p style="font-size: 13px; color: #aaa;">Nhận mã giảm giá và sản phẩm mới sớm nhất.</p>
                <p>&copy; 2026 ELLA Store. All rights reserved.</p>
            </div>
        </div>
    </footer>
</body>
</html>


