@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Đăng ký</title>
    <link rel="stylesheet" href="~/Content/css/style.css">

</head>

<body>
    <div class="container-custom">

        <div class="auth-wrapper">

            <!-- KHỐI FORM ĐĂNG KÝ -->
            <div class="auth-box">

                <h2>Tạo Tài Khoản Mới</h2>

                <form onsubmit="return validateForm()">

                    <div class="form-group">
                        <label>Tên đăng nhập (Username) *</label>

                        <input type="text" id="username" class="form-control">

                        <span id="username_err" class="error-msg"></span>
                    </div>


                    <div class="form-group">
                        <label>Mật khẩu *</label>

                        <input type="password" id="password" class="form-control">

                        <span id="password_err" class="error-msg"></span>
                    </div>


                    <div class="form-group">
                        <label>Xác nhận mật khẩu *</label>

                        <input type="password" id="repass" class="form-control">

                        <span id="repass_err" class="error-msg"></span>
                    </div>


                    <button type="submit" class="btn">
                        Tạo tài khoản
                    </button>

                </form>


                <p>
                    Đã có tài khoản?
                    <a href="/Home/Dangnhap">Đăng nhập</a>
                </p>

            </div>

        </div>

    </div>


    <!-- JAVASCRIPT KIỂM TRA DỮ LIỆU -->
    <script>

        function validateForm() {

            // Xóa thông báo lỗi cũ
            document.getElementById("username_err").innerText = "";
            document.getElementById("password_err").innerText = "";
            document.getElementById("repass_err").innerText = "";


            // Lấy dữ liệu người dùng nhập
            var user = document.getElementById("username").value;
            var pass = document.getElementById("password").value;
            var repass = document.getElementById("repass").value;


            // Ban đầu cho rằng dữ liệu hợp lệ
            var isValid = true;


            // Kiểm tra Username
            var userRegex = /^[a-zA-Z0-9]{5,}$/;

            if (!userRegex.test(user)) {

                document.getElementById("username_err").innerText =
                    "Tên đăng nhập phải từ 5 ký tự trở lên và không chứa ký tự đặc biệt!";

                isValid = false;
            }


            // Kiểm tra độ dài mật khẩu
            if (pass.length < 8) {

                document.getElementById("password_err").innerText =
                    "Mật khẩu hệ thống yêu cầu chứa tối thiểu 8 ký tự!";

                isValid = false;
            }


            // Kiểm tra mật khẩu nhập lại
            if (pass !== repass) {

                document.getElementById("repass_err").innerText =
                    "Mật khẩu xác nhận gõ lại chưa trùng khớp!";

                isValid = false;
            }


            // Nếu tất cả đều đúng
            if (isValid) {

                alert(
                    "Hệ thống chấp nhận dữ liệu! Đăng ký thành công tài khoản: "
                    + user
                );
            }


            return isValid;
        }

    </script>
    <!-- FOOTER -->
    <footer class="footer">
        <div class="footer-content">
            <div class="footer-section trai">
                <h3>VỀ ELLA STORE</h3>
                <p>Hệ thống thời trang giày dép uy tín, chất lượng hàng đầu.</p>
                <p>Địa chỉ: 123 Đường ABC, TP.HCM</p>
                <p>Hotline: 0123 456 789</p>
            </div>
            <div class="footer-section trai">
                <h3>HỖ TRỢ KHÁCH HÀNG</h3>
                <p><a href="#">Hướng dẫn mua hàng</a></p>
                <p><a href="#">Chính sách đổi trả</a></p>
                <p><a href="#">Chính sách bảo mật</a></p>
                <p><a href="#">Phương thức thanh toán</a></p>
            </div>
            <div class="footer-section phai">
                <h3>CHÍNH SÁCH</h3>
                <p><a href="#">Chính sách vận chuyển</a></p>
                <p><a href="#">Chính sách kiểm hàng</a></p>
                <p><a href="#">Quy định chung</a></p>
            </div>
            <div class="footer-section phai">
                <h3>KẾT NỐI VỚI CHÚNG TÔI</h3>
                <p><a href="#">Facebook</a> | <a href="#">Instagram</a></p>
                <p><a href="#">TikTok</a> | <a href="#">Shopee</a></p>
                <h3 style="margin-top: 15px; font-size: 15px;">ĐĂNG KÝ NHẬN TIN</h3>
                <p style="font-size: 13px; color: #aaa;">Nhận mã giảm giá và sản phẩm mới sớm nhất.</p>
                <p>&copy; 2026 ELLA Store. All rights reserved.</p>
            </div>
        </div>
    </footer>
</body>
</html>






