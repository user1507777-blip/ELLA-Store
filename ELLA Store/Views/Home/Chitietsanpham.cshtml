            document.querySelector(".detail-image img").src =
                sanPhamDangXem.image;

            document.querySelector(".shoe-name").innerText =
                sanPhamDangXem.name;

            document.querySelector(".shoe-price").innerText =
                sanPhamDangXem.price.toLocaleString("vi-VN") + "đ";

            document.querySelector(".detail-info p").innerText =
                sanPhamDangXem.description;

        }
        // ==========================================
        // CHỌN SIZE
        // ==========================================
        let sizeDaChon = "40"
        function selectSize(element) {
            let cacSize =
                document.querySelectorAll(".size-box");
            cacSize.forEach(function (size) {
                size.classList.remove("active");
            });
            element.classList.add("active");
            sizeDaChon =
                element.innerText;
        }
        // ==========================================
        // THÊM VÀO GIỎ HÀNG
        // ==========================================

        function themVaoGio() {

            let sanPham = {

                name: sanPhamDangXem.name,

                price: sanPhamDangXem.price,

                image: sanPhamDangXem.image,

                size: sizeDaChon,

                quantity: 1

            };
            let gioHang =
                JSON.parse(
                    localStorage.getItem("cart")
                ) || [];
            gioHang.push(sanPham);
            localStorage.setItem(
                "cart",
                JSON.stringify(gioHang)
            );
            alert("Đã thêm sản phẩm vào giỏ hàng!");
            window.location.href =
                "/Home/GioHang";
